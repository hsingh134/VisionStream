#usda 1.0
# Modified from Khaos Tian's Apache-2.0 SBSMaterial (2024).
# See THIRD_PARTY_NOTICES.md and Licenses/Apache-2.0.txt.
# Changes: independent eye textures and emissive shading; splitting occurs in Metal.
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Root" {
    def Material "StereoMaterial" {
        asset inputs:leftEye
        asset inputs:rightEye
        token outputs:mtlx:surface.connect = </Root/StereoMaterial/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "CameraSwitch" {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_color3"
            color3f inputs:left.connect = </Root/StereoMaterial/Left.outputs:out>
            color3f inputs:mono.connect = </Root/StereoMaterial/Left.outputs:out>
            color3f inputs:right.connect = </Root/StereoMaterial/Right.outputs:out>
            color3f outputs:out
        }
        def Shader "Surface" {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </Root/StereoMaterial/CameraSwitch.outputs:out>
            float inputs:opacity = 1
            float inputs:roughness = 1
            token outputs:out
        }
        def Shader "Left" {
            uniform token info:id = "ND_tiledimage_color3"
            asset inputs:file.connect = </Root/StereoMaterial.inputs:leftEye>
            float2 inputs:uvtiling = (1, 1)
            color3f outputs:out
        }
        def Shader "Right" {
            uniform token info:id = "ND_tiledimage_color3"
            asset inputs:file.connect = </Root/StereoMaterial.inputs:rightEye>
            float2 inputs:uvtiling = (1, 1)
            color3f outputs:out
        }
    }
}
